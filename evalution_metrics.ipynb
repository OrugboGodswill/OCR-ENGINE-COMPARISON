      "source": [
        "metrics = ['cer', 'wer', 'ned']\n",
        "fig, axes = plt.subplots(1, 3, figsize=(20, 6), sharey=False) # Separate y-axes for different scales\n",
        "\n",
        "# Define the order of engines for consistent plotting\n",
        "engine_order = ['easyocr', 'tesseract', 'paddleocr']\n",
        "\n",
        "for i, metric in enumerate(metrics):\n",
        "    ax = axes[i]\n",
        "    # Reorder the DataFrame for consistent plotting if necessary\n",
        "    df_overall_avg_filtered.loc[engine_order, metric].plot(kind='bar', ax=ax, color=[colors[e] for e in engine_order])\n",
        "    ax.set_title(f'Overall Average {metric.upper()} by OCR Engine', fontsize=14)\n",
        "    ax.set_xlabel('OCR Engine', fontsize=12)\n",
        "    if metric == 'ned':\n",
        "        ax.set_ylabel(f'{metric.upper()} Score (Higher is Better)', fontsize=12)\n",
        "    else:\n",
        "        ax.set_ylabel(f'{metric.upper()} Score (Lower is Better)', fontsize=12)\n",
        "    ax.tick_params(axis='x', rotation=45)\n",
        "    ax.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.suptitle('Overall Average Performance of OCR Engines', fontsize=18, y=1.02)\n",
        "plt.savefig('overall_average_performance.png')\n",
        "plt.show()"
      ],
