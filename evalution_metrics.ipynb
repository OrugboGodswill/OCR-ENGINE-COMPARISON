      "source": [
        "!pip install python-Levenshtein jiwer pandas numpy easyocr paddleocr pytesseract paddlepaddle\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "import Levenshtein\n",
        "from jiwer import wer\n",
        "import pytesseract as run_tesseract\n",
        "from paddleocr import PaddleOCR\n",
        "import easyocr\n",
        "from PIL import Image\n",
        "\n",
        "# CER ACCURACY\n",
        "def calculate_cer(reference: str, hypothesis: str) -> float:\n",
        "    reference = reference.strip()\n",
        "    hypothesis = hypothesis.strip()\n",
        "\n",
        "    if len(reference) == 0:\n",
        "        return 0.0\n",
        "\n",
        "    edit_distance = Levenshtein.distance(reference, hypothesis)\n",
        "    cer = (edit_distance / len(reference)) * 100\n",
        "    return round(cer, 4)\n",
        "\n",
        "#WER ACCURACY\n",
        "def calculate_wer(reference: str, hypothesis: str) -> float:\n",
        "    reference = reference.strip()\n",
        "    hypothesis = hypothesis.strip()\n",
        "\n",
        "    if len(reference.split()) == 0:\n",
        "        return 0.0\n",
        "\n",
        "    return round(wer(reference, hypothesis) * 100, 4)\n",
        "\n",
        "#NED ACCURACY\n",
        "def calculate_normalized_edit_distance(reference: str, hypothesis: str) -> float:\n",
        "    reference = reference.strip()\n",
        "    hypothesis = hypothesis.strip()\n",
        "\n",
        "    if not reference and not hypothesis:\n",
        "        return 1.0\n",
        "\n",
        "    edit_distance = Levenshtein.distance(reference, hypothesis)\n",
        "    max_len = max(len(reference), len(hypothesis))\n",
        "    ned = 1 - (edit_distance / max_len)\n",
        "    return round(ned, 4)\n",
        "\n",
        "\n",
        "# CELL LEVEL ACCURACY\n",
        "def calculate_cell_level_metrics(ground_truth_cells, ocr_cells):\n",
        "    # Number of comparable cells = smaller of the two lists\n",
        "    matched = min(len(ground_truth_cells), len(ocr_cells))\n",
        "\n",
        "    # Edge case: no comparable cells\n",
        "    if matched == 0:\n",
        "        return {\n",
        "            \"avg_cer\": 0.0,\n",
        "            \"avg_wer\": 0.0,\n",
        "            \"per_cell\": [],\n",
        "            \"matched_cells\": 0\n",
        "        }\n",
        "\n",
        "    per_cell_results = []\n",
        "    total_cer = 0.0\n",
        "    total_wer = 0.0\n",
        "\n",
        "    # Compute CER & WER for each cell pair\n",
        "    for i in range(matched):\n",
        "        gt = ground_truth_cells[i]\n",
        "        ocr = ocr_cells[i]\n",
        "\n",
        "        cer = calculate_cer(gt, ocr)\n",
        "        wer_ = calculate_wer(gt, ocr)\n",
        "\n",
        "        total_cer += cer\n",
        "        total_wer += wer_\n",
        "\n",
        "        per_cell_results.append({\n",
        "            \"cell_index\": i,\n",
        "            \"gt\": gt,\n",
        "            \"ocr\": ocr,\n",
        "            \"cer\": cer,\n",
        "            \"wer\": wer_\n",
        "        })\n",
        "\n",
        "    # Compute averages\n",
        "    avg_cer = round(total_cer / matched, 4)\n",
        "    avg_wer = round(total_wer / matched, 4)\n",
        "\n",
        "    return {\n",
        "        \"avg_cer\": avg_cer,\n",
        "        \"avg_wer\": avg_wer,\n",
        "        \"per_cell\": per_cell_results,\n",
        "        \"matched_cells\": matched\n",
        "    }\n",
        "\n",
        "# OCR Structure Metric Accuracy\n",
        "def calculate_structure_metrics(ground_truth_structure, ocr_structure):\n",
        "\n",
        "\n",
        "    gt_cells = ground_truth_structure.get(\"cells\", [])\n",
        "    ocr_cells = ocr_structure.get(\"cells\", [])\n",
        "\n",
        "    total_gt = len(gt_cells)\n",
        "    detected_cells = len(ocr_cells)\n",
        "\n",
        "    if total_gt == 0:\n",
        "        return {\n",
        "            \"cell_detection_rate\": 0.0,\n",
        "            \"position_accuracy\": 0.0,\n",
        "            \"total_gt_cells\": 0,\n",
        "            \"detected_cells\": detected_cells,\n",
        "            \"correct_position_cells\": 0\n",
        "        }\n",
        "\n",
        "    # Convert OCR cells into lookup by (row, col)\n",
        "    ocr_map = {(cell[\"row\"], cell[\"col\"]): cell for cell in ocr_cells}\n",
        "\n",
        "    correct_positions = 0\n",
        "    correctly_detected = 0\n",
        "\n",
        "    for gt_cell in gt_cells:\n",
        "        key = (gt_cell[\"row\"], gt_cell[\"col\"])\n",
        "\n",
        "        # Did OCR detect a cell in this row/col?\n",
        "        if key in ocr_map:\n",
        "            correctly_detected += 1\n",
        "            correct_positions += 1  # row and col are correct\n",
        "\n",
        "    cell_detection_rate = round(correctly_detected / total_gt, 4)\n",
        "    position_accuracy = round(correct_positions / total_gt, 4)\n",
        "\n",
        "    return {\n",
        "        \"cell_detection_rate\": cell_detection_rate,\n",
        "        \"position_accuracy\": position_accuracy,\n",
        "        \"total_gt_cells\": total_gt,\n",
        "        \"detected_cells\": detected_cells,\n",
        "        \"correct_position_cells\": correct_positions\n",
        "    }\n",
        "\n",
        "\n",
        "def run_evaluation_on_folder(text_images_dir):\n",
        "    results = []\n",
        "\n",
        "    paddle_ocr_reader = PaddleOCR(use_angle_cls=True, lang='korean')\n",
        "    # Initialize EasyOCR reader with desired languages (e.g., 'en' for English or 'ko' for Korean if your images are in Korean)\n",
        "    easy_ocr_reader = easyocr.Reader(['ko', 'en']) # Added Korean and English support\n",
        "\n",
        "    for filename in os.listdir(text_images_dir):\n",
        "        if not filename.lower().endswith((\".png\", \".jpg\", \".jpeg\")):\n",
        "            continue\n",
        "\n",
        "        image_path = os.path.join(text_images_dir, filename)\n",
        "\n",
        "        # Match ground truth .txt file\n",
        "        base_name = os.path.splitext(filename)[0]\n",
        "        gt_path = os.path.join(text_images_dir, base_name + \"_gt.txt\")\n",
        "\n",
        "        if not os.path.exists(gt_path):\n",
        "            print(f\"[WARNING] No ground truth file for {filename}\")\n",
        "            continue\n",
        "\n",
        "        # Load ground truth text\n",
        "        with open(gt_path, \"r\", encoding=\"utf-8\") as f:\n",
        "            ground_truth = f.read().strip()\n",
        "\n",
        "        # Run OCR with all three engines\n",
        "        paddle_result = paddle_ocr_reader.ocr(image_path)\n",
        "        easy_result = easy_ocr_reader.readtext(image_path) # Call readtext on the reader instance\n",
        "        easy_result = ' '.join([res[1] for res in easy_result]) # Extract text and join\n",
        "        tesseract_result = run_tesseract.image_to_string(Image.open(image_path)) # Tesseract needs PIL Image object\n",
        "\n",
        "        # Calculate metrics for each engine\n",
        "        paddle_metrics = {\n",
        "            'cer': calculate_cer(ground_truth, str(paddle_result)), # Convert paddle result to string\n",
        "            'wer': calculate_wer(ground_truth, str(paddle_result)),\n",
        "            'ned': calculate_normalized_edit_distance(ground_truth, str(paddle_result))\n",
        "\n",
        "        }\n",
        "\n",
        "        easy_metrics = {\n",
        "            'cer': calculate_cer(ground_truth, easy_result),\n",
        "            'wer': calculate_wer(ground_truth, easy_result),\n",
        "            'ned': calculate_normalized_edit_distance(ground_truth, easy_result)\n",
        "        }\n",
        "\n",
        "        tesseract_metrics = {\n",
        "            'cer': calculate_cer(ground_truth, tesseract_result),\n",
        "            'wer': calculate_wer(ground_truth, tesseract_result),\n",
        "            'ned': calculate_normalized_edit_distance(ground_truth, tesseract_result)\n",
        "        }\n",
        "\n",
        "        # Push result to list\n",
        "        results.append({\n",
        "            \"image\": filename,\n",
        "            \"paddleocr\": paddle_metrics,\n",
        "            \"easyocr\": easy_metrics,\n",
        "            \"tesseract\": tesseract_metrics\n",
        "        })\n",
        "\n",
        "        print(f\"[DONE] Processed {filename}\")\n",
        "\n",
        "    return results\n",
        "\n",
        "results = run_evaluation_on_folder(\"/content/drive/MyDrive/text_images/\")\n",
        "print(results)"
      ]
    },
