      "source": [
        "plt.style.use('seaborn-v0_8-whitegrid') # Using a clean style\n",
        "\n",
        "# Define a color palette for the engines\n",
        "colors = {'paddleocr': '#4CAF50', 'easyocr': '#2196F3', 'tesseract': '#FF9800'}\n",
        "\n",
        "# --- Plotting CER per image ---\n",
        "fig_cer, ax_cer = plt.subplots(figsize=(12, 6))\n",
        "df_per_image_pivot_cer.plot(kind='bar', ax=ax_cer, color=[colors.get(col, '#333333') for col in df_per_image_pivot_cer.columns])\n",
        "ax_cer.set_title('Per-Image CER Comparison of OCR Engines', fontsize=16)\n",
        "ax_cer.set_xlabel('Image', fontsize=12)\n",
        "ax_cer.set_ylabel('CER Score (Lower is Better)', fontsize=12)\n",
        "ax_cer.tick_params(axis='x', rotation=45)\n",
        "ax_cer.legend(title='OCR Engine', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "ax_cer.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.savefig('per_image_cer_comparison.png')\n",
        "plt.show()\n",
        "\n",
        "# --- Plotting WER per image ---\n",
        "fig_wer, ax_wer = plt.subplots(figsize=(12, 6))\n",
        "df_per_image_pivot_wer.plot(kind='bar', ax=ax_wer, color=[colors.get(col, '#333333') for col in df_per_image_pivot_wer.columns])\n",
        "ax_wer.set_title('Per-Image WER Comparison of OCR Engines', fontsize=16)\n",
        "ax_wer.set_xlabel('Image', fontsize=12)\n",
        "ax_wer.set_ylabel('WER Score (Lower is Better)', fontsize=12)\n",
        "ax_wer.tick_params(axis='x', rotation=45)\n",
        "ax_wer.legend(title='OCR Engine', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "ax_wer.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.savefig('per_image_wer_comparison.png')\n",
        "plt.show()\n",
        "\n",
        "# --- Plotting NED per image ---\n",
        "fig_ned, ax_ned = plt.subplots(figsize=(12, 6))\n",
        "df_per_image_pivot_ned.plot(kind='bar', ax=ax_ned, color=[colors.get(col, '#333333') for col in df_per_image_pivot_ned.columns])\n",
        "ax_ned.set_title('Per-Image Normalized Edit Distance (NED) Comparison of OCR Engines', fontsize=16)\n",
        "ax_ned.set_xlabel('Image', fontsize=12)\n",
        "ax_ned.set_ylabel('NED Score (Higher is Better)', fontsize=12)\n",
        "ax_ned.tick_params(axis='x', rotation=45)\n",
        "ax_ned.legend(title='OCR Engine', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "ax_ned.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.savefig('per_image_ned_comparison.png')\n",
        "plt.show()"
      ],
