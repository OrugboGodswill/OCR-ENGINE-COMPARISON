      "source": [
        "# Flatten the results to show per-image breakdown clearly\n",
        "flat_results = []\n",
        "for index, row in df_results.iterrows():\n",
        "    for engine in ['paddleocr', 'easyocr', 'tesseract']:\n",
        "        flat_results.append({\n",
        "            'image': row['image'],\n",
        "            'engine': engine,\n",
        "            'cer': row[engine]['cer'],\n",
        "            'wer': row[engine]['wer'],\n",
        "            'ned': row[engine]['ned']\n",
        "        })\n",
        "\n",
        "df_per_image = pd.DataFrame(flat_results)\n",
        "display(df_per_image.pivot(index='image', columns='engine', values=['cer', 'wer', 'ned']))\n",
        "\n",
        "# Optionally, save to CSV\n",
        "df_per_image.to_csv('test_results.csv', index=False)\n",
        "print(\"\\nPer-image breakdown saved to 'test_results.csv'\")"
      ]
    },
