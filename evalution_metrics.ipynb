      "source": [
        "# Initialize dictionaries to store total CER, WER, and NED for each engine\n",
        "total_cer = {'paddleocr': 0.0, 'easyocr': 0.0, 'tesseract': 0.0}\n",
        "total_wer = {'paddleocr': 0.0, 'easyocr': 0.0, 'tesseract': 0.0}\n",
        "total_ned = {'paddleocr': 0.0, 'easyocr': 0.0, 'tesseract': 0.0}\n",
        "\n",
        "num_images = len(df_results)\n",
        "\n",
        "# Aggregate scores\n",
        "for index, row in df_results.iterrows():\n",
        "    for engine in ['paddleocr', 'easyocr', 'tesseract']:\n",
        "        total_cer[engine] += row[engine]['cer']\n",
        "        total_wer[engine] += row[engine]['wer']\n",
        "        total_ned[engine] += row[engine]['ned']\n",
        "\n",
        "# Calculate average scores\n",
        "overall_average_scores = {}\n",
        "for engine in ['paddleocr', 'easyocr', 'tesseract']:\n",
        "    overall_average_scores[engine] = {\n",
        "        'avg_cer': round(total_cer[engine] / num_images, 4),\n",
        "        'avg_wer': round(total_wer[engine] / num_images, 4),\n",
        "        'avg_ned': round(total_ned[engine] / num_images, 4)\n",
        "    }\n",
        "\n",
        "# Convert to DataFrame for better display\n",
        "df_overall_avg = pd.DataFrame.from_dict(overall_average_scores, orient='index')\n",
        "df_overall_avg.index.name = 'OCR Engine'\n",
        "display(df_overall_avg)\n",
        "\n",
        "# Determine the best engine based on average CER (lower is better)\n",
        "best_engine_cer = df_overall_avg['avg_cer'].idxmin()\n",
        "best_cer_score = df_overall_avg['avg_cer'].min()\n",
        "\n",
        "print(f\"\\nBest performing engine based on overall Average CER: {best_engine_cer} (CER: {best_cer_score})\")"
      ]
    },
